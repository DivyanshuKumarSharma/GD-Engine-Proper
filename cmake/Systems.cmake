find_package(Threads REQUIRED)
option(GD_ENABLE_TRACY "Fetch and enable pinned Tracy profiling client" OFF)
option(GD_GOOGLE_BENCHMARK "Fetch Google Benchmark and build algorithm benchmarks" OFF)
set(GD_SANITIZER "" CACHE STRING "Headless sanitizer: address or thread (Clang/GCC)")
if(GD_SANITIZER)
  if(MSVC OR NOT GD_SANITIZER MATCHES "^(address|thread)$")
    message(FATAL_ERROR "GD_SANITIZER requires Clang/GCC and address or thread")
  endif()
  add_compile_options(-fsanitize=${GD_SANITIZER} -fno-omit-frame-pointer -g)
  add_link_options(-fsanitize=${GD_SANITIZER})
endif()
add_library(EngineSystems STATIC
  engine/source/systems/JobSystem.cpp
  engine/source/systems/SpatialIndex.cpp
  engine/source/systems/Navigation.cpp
  engine/source/systems/Netcode.cpp
  engine/source/systems/FrameRecorder.cpp)
target_include_directories(EngineSystems PUBLIC engine/source engine/thirdparty/glm-1.0.1)
target_link_libraries(EngineSystems PUBLIC Threads::Threads)
if(WIN32)
  target_link_libraries(EngineSystems PUBLIC ws2_32)
endif()
if(GD_ENABLE_TRACY OR GD_GOOGLE_BENCHMARK)
  include(FetchContent)
endif()
if(GD_ENABLE_TRACY)
  set(TRACY_ENABLE ON CACHE BOOL "" FORCE)
  set(TRACY_ONLY_LOCALHOST ON CACHE BOOL "Local profiling connections only")
  set(TRACY_NO_SYSTEM_TRACING ON CACHE BOOL "No elevated kernel tracing required")
  FetchContent_Declare(tracy GIT_REPOSITORY https://github.com/wolfpld/tracy.git GIT_TAG v0.11.1 GIT_SHALLOW TRUE)
  FetchContent_MakeAvailable(tracy)
  target_link_libraries(EngineSystems PUBLIC TracyClient)
  target_compile_definitions(EngineSystems PUBLIC GD_ENABLE_TRACY=1)
endif()
add_executable(systems_tests tests/systems_tests.cpp)
target_link_libraries(systems_tests PRIVATE EngineSystems)
add_executable(systems_bench tools/systems_bench.cpp)
target_link_libraries(systems_bench PRIVATE EngineSystems)
add_executable(netcode_demo tools/netcode_demo.cpp)
target_link_libraries(netcode_demo PRIVATE EngineSystems)
enable_testing()
add_test(NAME systems_tests COMMAND systems_tests)
add_test(NAME netcode_loopback COMMAND netcode_demo --ticks 180 --loss 0.05 --latency 75 --jitter 20)
set_tests_properties(systems_tests netcode_loopback PROPERTIES TIMEOUT 45 LABELS "systems;headless")
if(GD_GOOGLE_BENCHMARK)
  set(BENCHMARK_ENABLE_TESTING OFF CACHE BOOL "" FORCE)
  set(BENCHMARK_ENABLE_GTEST_TESTS OFF CACHE BOOL "" FORCE)
  FetchContent_Declare(googlebenchmark GIT_REPOSITORY https://github.com/google/benchmark.git GIT_TAG v1.9.1 GIT_SHALLOW TRUE)
  FetchContent_MakeAvailable(googlebenchmark)
  add_executable(algorithm_bench tools/google_bench.cpp)
  target_link_libraries(algorithm_bench PRIVATE EngineSystems benchmark::benchmark_main)
endif()
